# .env.example
# Copy to .env and set values as needed

# Network
HOST=127.0.0.1
PORT=8100

# Moodle URLs
MOODLE_BASE_URL=https://courses.iiit.ac.in
CAS_LOGIN_URL=https://login.iiit.ac.in

# Browser & Session
SESSION_DIR=./session
CACHE_DIR=./cache
CHROMIUM_PATH=

# Performance
CACHE_TTL=300
THROTTLE_DELAY=1.0

# Logging
LOG_LEVEL=INFO
